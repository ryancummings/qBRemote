devices([
  "qbremote-PromoShots-17ProMax",
  "qbremote-PromoShots-iPadPro13"
])

languages([
  "en-US"
])

scheme("qbremote")

# Format build output with xcbeautify. Keep simulator tests serial to prevent
# cloned test runners from failing to launch.
xcodebuild_formatter("xcbeautify")
xcargs("-parallel-testing-enabled NO")

output_directory("./fastlane/screenshots")
clear_previous_screenshots(true)

# Use 9:41, full battery, and full reception for store screenshots.
override_status_bar(true)
